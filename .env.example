# Entorno (development, testing, production)
ENV=development
LOG_LEVEL=INFO

# Base de datos (SQLite async por defecto, o PostgreSQL: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./data/canchas.db

# Telegram Bot (Obtenido desde @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Google Gemini API Key (Obtenida gratis desde Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# Tenant / Complejo por defecto
DEFAULT_TENANT_SLUG=demo-complejo
DEFAULT_TENANT_NAME="Complejo Deportivo Demo"
