# Entorno (development, testing, production)
ENV=development
LOG_LEVEL=INFO

# Base de datos (SQLite async por defecto, o PostgreSQL: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./data/canchas.db

# Telegram Bot (Obtenido desde @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Proveedor de IA a utilizar: 'gemini' o 'openrouter'
AI_PROVIDER=openrouter

# Google Gemini AI (Si AI_PROVIDER=gemini)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter AI (Si AI_PROVIDER=openrouter)
# Obtén tu key gratis en https://openrouter.ai/
OPENROUTER_API_KEY=tu_openrouter_key_aqui
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tenant / Complejo por defecto
DEFAULT_TENANT_SLUG=demo-complejo
DEFAULT_TENANT_NAME="Complejo Deportivo Demo"

# Autenticación Web (JWT)
JWT_SECRET_KEY=tu_clave_secreta_jwt_muy_segura
ADMIN_DEFAULT_PASSWORD=admin123

